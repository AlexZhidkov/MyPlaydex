{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "site": "myplaydex",
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "**/.*",
      "**/node_modules/**",
      "test/**",
      ".github/**",
      ".scratch/**",
      "docs/**",
      "prototype/**",
      "package*.json",
      "*.md",
      "LICENSE",
      "src/crawler-*.js",
      "src/crawlers/**",
      "src/firestore-adapter.js",
      "src/mock-perth-activities.js",
      "src/url-verifier.js",
      "src/verifier-cli.js"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=3600"
          }
        ]
      }
    ]
  }
}
