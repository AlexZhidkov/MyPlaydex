{
  "name": "myplaydex",
  "version": "0.1.0",
  "type": "module",
  "description": "MyPlaydex amateur sports and activities discovery platform",
  "scripts": {
    "test": "node --test test/*.test.js",
    "crawl": "node src/crawler-runner.js",
    "crawl:dry-run": "node src/crawler-runner.js --dry-run",
    "verify-urls": "node src/verifier-cli.js",
    "seed": "node src/crawler-runner.js --seed",
    "prototype": "python3 -m http.server 3000",
    "deploy:hosting": "npx -y firebase-tools@latest deploy --only hosting",
    "deploy:rules": "npx -y firebase-tools@latest deploy --only firestore:rules",
    "serve:hosting": "npx -y firebase-tools@latest emulators:start --only hosting"
  },
  "dependencies": {
    "firebase-admin": "^12.0.0"
  },
  "keywords": [
    "sports",
    "discovery",
    "perth",
    "vanilla-js"
  ],
  "author": "Alexander Zhidkov",
  "license": "MIT"
}