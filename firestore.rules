rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// This security rules file assumes the following data structures:
//
// Collection: activities
// Document ID: {source}_{source_id} (deterministic slug)
// Fields:
//   - id: string (required, immutable) - Deterministic activity identifier
//   - region_id: string (required) - Partition identifier (e.g., "perth")
//   - source: string (required, immutable) - Data source slug
//   - source_id: string (required, immutable) - Source-specific identifier
//   - source_url: string | null (optional) - Verified outbound referral URL
//   - raw_source_url: string | null (optional) - Original candidate referral URL
//   - title: string (required) - Activity title
//   - description: string (optional) - Activity description
//   - category: string (required) - Top-level category ("sports")
//   - subcategory: string (required) - Normalized sport slug
//   - organizer: map (required) - Embedded public organizer summary { id, name }
//   - venue: map (required) - Embedded venue summary { id, name, coordinates: { lat, lng }, geohash }
//   - schedule: map (required) - AWST schedule { start_date, end_date, start_time, end_time, recurrence, day_of_week }
//   - cost: map (required) - Cost metadata { is_free, display_price }
//   - demographics: map (required) - Target demographics { gender, age }
//   - verified: bool (required) - Whether source_url has been verified reachable
//   - created_at: timestamp (required, immutable) - Native Firestore creation timestamp
//   - updated_at: timestamp (required) - Native Firestore last update timestamp
//
// Collection: organizers
// Document ID: org_{slug}
// Fields:
//   - id: string (required, immutable) - Deterministic organizer ID
//   - region_id: string (required) - Partition identifier (e.g., "perth")
//   - name: string (required) - Organizer name
//   - description: string (optional) - Organizer description
//   - address: string (optional) - Street or club address
//   - coordinates: map (required) - { lat: number, lng: number }
//   - geohash: string (required) - Precision-9 Base32 geohash
//   - category: string (required) - Top-level category ("sports")
//   - subcategory: string (required) - Primary normalized sport slug
//   - subcategories: list<string> (required) - Normalized sport slugs (string[])
//   - website: string | null (optional) - Official website URL
//   - contact: map (optional) - Public directory contact details { email: string | null, phone: string | null }
//   - cost_description: string (optional) - Cost or membership fee summary
//   - demographics: map (optional) - Target demographics { gender, age }
//   - source_url: string | null (optional) - Verified outbound referral URL
//   - raw_source_url: string | null (optional) - Original candidate referral URL
//   - verified: bool (required) - Whether source_url has been verified reachable
//   - created_at: timestamp (required, immutable) - Native Firestore creation timestamp
//   - updated_at: timestamp (required) - Native Firestore last update timestamp
//
// Collection: venues
// Document ID: venue_{slug}_{geohash6}
// Fields:
//   - id: string (required, immutable) - Deterministic venue ID
//   - region_id: string (required) - Partition identifier (e.g., "perth")
//   - name: string (required) - Venue name
//   - description: string (optional) - Venue description
//   - address: string (optional) - Street address
//   - coordinates: map (required) - { lat: number, lng: number }
//   - geohash: string (required) - Precision-9 Base32 geohash
//   - category: string (required) - Top-level category ("sports")
//   - subcategory: string (required) - Primary normalized sport slug
//   - subcategories: list<string> (required) - Normalized sport slugs (string[])
//   - source_url: string | null (optional) - Verified outbound referral URL
//   - raw_source_url: string | null (optional) - Original candidate referral URL
//   - verified: bool (required) - Whether source_url has been verified reachable
//   - created_at: timestamp (required, immutable) - Native Firestore creation timestamp
//   - updated_at: timestamp (required) - Native Firestore last update timestamp
//
// Collection: regions
// Document ID: {regionId} (e.g., "perth")
// Fields:
//   - id: string (required, immutable) - Region slug
//   - name: string (required) - Display name
//   - coordinates: map (required) - Centroid { lat: number, lng: number }
//   - default_radius_km: number (required) - Default search radius
//   - created_at: timestamp (required, immutable) - Native Firestore creation timestamp
//   - updated_at: timestamp (required) - Native Firestore last update timestamp
//
// Access Model:
//   - Public unauthenticated read access (get, list) is permitted on
//     /activities/{activityId}, /organizers/{organizerId}, and /venues/{venueId}
//     so the browser discovery client can fetch sanitized discovery listings
//     across all three tabs via the Cloud Firestore REST API.
//   - Authenticated Admins (Firebase Auth custom claim `admin == true`) have
//     read, create, update, and delete access on /activities/{activityId},
//     /organizers/{organizerId}, and /venues/{venueId} for /admin workspace
//     curation, with `id` and `created_at` enforced immutable on update.
//   - Authenticated Admins have read-only access on /regions/{regionId}; all
//     client writes to /regions are denied (backend-only).
//   - Backend ingestion and verification pipelines use the privileged Firebase
//     Admin SDK (which bypasses Firestore Security Rules).
//   - Non-admin users and unauthenticated clients are denied all writes and
//     denied read/write access on /regions and all other paths.
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the caller is an authenticated Admin via Firebase Auth custom claim.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Ensure immutable listing identity and creation timestamp are preserved on update.
    function immutableListingFieldsPreserved() {
      return 'id' in resource.data &&
        'created_at' in resource.data &&
        'id' in request.resource.data &&
        'created_at' in request.resource.data &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.created_at == resource.data.created_at;
    }

    // Public discovery feed (scheduled activities): read-only for browser clients.
    // Admins may create, update (preserving id and created_at), and delete.
    match /activities/{activityId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() && immutableListingFieldsPreserved();
    }

    // Public discovery directory (canonical organizers with public directory contact details):
    // read-only for browser clients; Admins may create, update (preserving id and created_at), and delete.
    match /organizers/{organizerId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() && immutableListingFieldsPreserved();
    }

    // Public discovery directory (canonical venues): read-only for browser clients.
    // Admins may create, update (preserving id and created_at), and delete.
    match /venues/{venueId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() && immutableListingFieldsPreserved();
    }

    // Canonical regions collection: Admin read-only; all client writes denied (backend-only).
    match /regions/{regionId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Default deny for all other collections and document paths.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
