rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// This security rules file assumes the following data structures:
//
// Collection: activities
// Document ID: {source}_{source_id} (deterministic slug)
// Fields:
//   - id: string (required, immutable) - Deterministic activity identifier
//   - region_id: string (required) - Partition identifier (e.g., "perth")
//   - source: string (required, immutable) - Data source slug
//   - source_id: string (required, immutable) - Source-specific identifier
//   - source_url: string | null (optional) - Verified outbound referral URL
//   - raw_source_url: string | null (optional) - Original candidate referral URL
//   - title: string (required) - Activity title
//   - description: string (optional) - Activity description
//   - category: string (required) - Top-level category ("sports")
//   - subcategory: string (required) - Normalized sport slug
//   - organizer: map (required) - Embedded public organizer summary { id, name }
//   - venue: map (required) - Embedded venue summary { id, name, coordinates: { lat, lng }, geohash }
//   - schedule: map (required) - AWST schedule { start_date, end_date, start_time, end_time, recurrence, day_of_week }
//   - cost: map (required) - Cost metadata { is_free, display_price }
//   - demographics: map (required) - Target demographics { gender, age }
//   - verified: bool (required) - Whether source_url has been verified reachable
//   - created_at: string (required, immutable) - ISO 8601 creation timestamp
//   - updated_at: string (required) - ISO 8601 last update timestamp
//
// Collection: venues
// Document ID: venue_{slug}_{geohash6}
// Fields:
//   - id: string (required, immutable) - Deterministic venue ID
//   - name: string (required) - Venue name
//   - address: string (optional) - Street address
//   - coordinates: map (required) - { lat: number, lng: number }
//   - geohash: string (required) - Precision-9 Base32 geohash
//   - region_id: string (required) - Region identifier
//   - updated_at: string (required) - ISO 8601 timestamp
//
// Collection: organizers
// Document ID: org_{slug}
// Fields:
//   - id: string (required, immutable) - Deterministic organizer ID
//   - name: string (required) - Organizer name
//   - website: string | null (optional) - Official website URL
//   - contact: map (optional, internal/PII) - { email: string | null, phone: string | null }
//   - updated_at: string (required) - ISO 8601 timestamp
//
// Collection: regions
// Document ID: {regionId} (e.g., "perth")
// Fields:
//   - id: string (required, immutable) - Region slug
//   - name: string (required) - Display name
//   - coordinates: map (required) - Centroid { lat: number, lng: number }
//   - default_radius_km: number (required) - Default search radius
//   - updated_at: string (required) - ISO 8601 timestamp
//
// Access Model:
//   - Public unauthenticated read access (get, list) is permitted ONLY on
//     /activities/{activityId} so the browser discovery client can fetch
//     sanitized activity listings via the Cloud Firestore REST API.
//   - All writes across all collections are performed exclusively by backend
//     ingestion and verification pipelines using the privileged Firebase Admin
//     SDK (which bypasses Firestore Security Rules).
//   - Client writes are strictly denied across the entire database.
//   - Client reads on /venues, /organizers (which may store contact PII),
//     and /regions are strictly denied.
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Public discovery feed: read-only for browser clients (including unauthenticated REST queries).
    // All writes are restricted to backend firebase-admin pipelines.
    match /activities/{activityId} {
      allow read: if true;
      allow write: if false;
    }

    // Canonical venues collection: backend-only access.
    match /venues/{venueId} {
      allow read, write: if false;
    }

    // Canonical organizers collection (contains contact details): backend-only access.
    match /organizers/{organizerId} {
      allow read, write: if false;
    }

    // Canonical regions collection: backend-only access.
    match /regions/{regionId} {
      allow read, write: if false;
    }

    // Default deny for all other collections and document paths.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
